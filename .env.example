# Novu Cloud: https://api.novu.co
# Self-hosted: use your Novu API service URL, for example https://novu-api.example.com
NOVU_API_URL=https://api.novu.co
NOVU_SECRET_KEY=replace_with_environment_secret
NOVU_SUBSCRIBER_ID=on-call:maya

# Workflow trigger identifiers created in your Novu environment.
NOVU_WORKFLOW_INCIDENT_CREATED=critical-incident
NOVU_WORKFLOW_INCIDENT_RESOLVED=incident-resolved
NOVU_WORKFLOW_INCIDENT_REJECTED=incident-action-rejected
NOVU_WORKFLOW_INCIDENT_SNOOZED=incident-snoozed

PORT=4173
HOST=0.0.0.0
